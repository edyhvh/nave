# NAVE Environment Configuration
# This file is automatically loaded by direnv when entering the directory

# Set environment variables
export NAVE_ENV="development"
export NAVE_ROOT="$(pwd)"

# Activate mise environment if available
if command -v mise &> /dev/null; then
    eval "$(mise activate bash)"
fi

# Make local venv Python/Pip available as plain `python` and `pip`
if [ -d ".venv/bin" ]; then
    export PATH="$(pwd)/.venv/bin:$PATH"
    export VIRTUAL_ENV="$(pwd)/.venv"
    export PYTHONPATH="$(pwd):$PYTHONPATH"
fi

# Welcome message
echo "🚀 NAVE environment activated!"
echo "Python: $(python --version 2>/dev/null || echo 'Not found')"
echo "Pip: $(pip --version 2>/dev/null || echo 'Not found')"
