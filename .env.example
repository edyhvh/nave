# OpenBB API Keys
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to the repository!

# FRED API Key (FREE)
# Get yours at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Financial Modeling Prep API Key (FREE tier available)
# Get yours at: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_fmp_api_key_here

# Optional: Other API keys if needed
# YAHOO_FINANCE_API_KEY=
# POLYGON_API_KEY=

# ── Trading configuration (no secrets here) ───────────────────────────────────
# Which wallet to use for trading (ironclaw | openfang)
HL_WALLET=openfang
# Use Hyperliquid testnet for paper trading (true | false)
HL_TESTNET=true
# Maximum position size per trade in USD
HL_MAX_POSITION_USD=100
# Minimum signal confidence threshold (0.0–1.0)
HL_MIN_CONFIDENCE=0.6

# ── Trade Journal GitHub Data Repo Sync (optional) ───────────────────────────
# Enables automatic snapshot sync to a dedicated GitHub data repository.
# Token should have write access to repository contents.
NAVE_GITHUB_DATA_REPO_OWNER=your-github-user-or-org
NAVE_GITHUB_DATA_REPO_NAME=nave-trades-data
NAVE_GITHUB_TOKEN=ghp_your_token_here

# Optional sync settings
NAVE_GITHUB_DATA_REPO_BRANCH=main
NAVE_GITHUB_DATA_BASE_PATH=trade_journal
NAVE_GITHUB_AUTO_SYNC=false

# ── Stock workflow (ISM + Massive.com fundamentals) ──────────────────────────
# Massive.com fundamentals API — free tier allows 5 requests per minute.
# Get a key at: https://massive.com/docs/rest/quickstart
MASSIVE_API_KEY=your_massive_api_key_here
# Optional overrides
# MASSIVE_BASE_URL=https://api.massive.com/v1
# MASSIVE_RATE_LIMIT_RPM=5

# Alpaca Markets (stub broker — integration pending)
# Get keys at: https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here
ALPACA_PAPER_TRADING=true

# Ondo Finance (stub — RWA/DeFi, reuses EVM wallet vault)
# ONDO_WALLET=hermes

# ── X (Twitter) social analysis (optional) ───────────────────────────────────
# Used by `nave stocks x-analyze` and the Hermes `stocks_x_analyze` tool.
# Official X API (preferred): https://developer.x.com/ → Bearer Token
# X_BEARER_TOKEN=your_bearer_token_here

# twscrape fallback — logged-in X account in a local SQLite DB:
#   python3 scripts/setup_x_twscrape.py --setup --login
# Or set cookie auth (browser devtools → Application → Cookies → x.com):
#   X_SCRAPE_USERNAME=your_handle
#   X_SCRAPE_COOKIES={"ct0":"...","auth_token":"..."}
# Or password login:
#   X_SCRAPE_USERNAME=...
#   X_SCRAPE_PASSWORD=...
#   X_SCRAPE_EMAIL=...
#   X_SCRAPE_EMAIL_PASSWORD=...
X_ACCOUNTS_DB=var/x_accounts.db

# ── Solana memecoin scanner (Pump.fun + Helius + DexScreener + Jupiter) ──────
# Helius is the only paid/keyed dependency. Free / Starter tier is enough
# for the scanner — the rate limiter and persistent JSON cache under
# var/memecoin_cache/ keep call volume well under the free quota.
# Get a key at: https://www.helius.dev/
HELIUS_API_KEY=your_helius_api_key_here
# Optional cache controls
# MEMECOIN_CACHE_TTL_SECONDS=300
# MEMECOIN_CACHE_DIR=var/memecoin_cache
